# ==============================================================================
# Almost Real AI Studio — Environment Configuration
# Copy to .env and fill in your values before running docker compose up
# ==============================================================================

# --- Google Gemini (AI Script & Image Generation) ---
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Facebook Graph API ---
# 1. Create App at developers.facebook.com → Business
# 2. Add "Graph API" product
# 3. Generate Page Access Token with: pages_show_list, pages_read_engagement, pages_manage_posts
# 4. Get Page ID from your Page About/Settings
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# --- Instagram Graph API (optional, future) ---
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_optional
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_optional

# --- YouTube Data API v3 (optional, future) ---
YOUTUBE_CLIENT_ID=your_youtube_client_id_optional
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_optional

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strongpassword123
POSTGRES_DB=almost_real
# Docker Compose sets this automatically to point to the postgres container.
# For local dev without Docker, use the sqlite fallback below.
DATABASE_URL=postgresql+asyncpg://postgres:strongpassword123@postgres:5432/almost_real
# Local dev (no Docker): DATABASE_URL=sqlite+aiosqlite:///./data/reelstudio.db

# --- Redis Cache ---
# Docker Compose sets this automatically to point to the redis container.
REDIS_URL=redis://redis:6379/0
# Local dev (no Docker): REDIS_URL=redis://localhost:6379/0

# --- Automation & Scheduling ---
DAILY_SCHEDULE_HOUR=10
DAILY_SCHEDULE_MINUTE=0
# AUTO_PUBLISH_FACEBOOK=true → generate AND immediately post to Facebook
# AUTO_PUBLISH_FACEBOOK=false → generate only, publish manually with one click
AUTO_PUBLISH_FACEBOOK=false

# --- Video Content Settings ---
# Niche options: "Almost Real (Hyperrealistic Scenarios)", "Tech & AI Horizons", "Mindset & Stoic Wisdom"
DEFAULT_NICHE=Almost Real (Hyperrealistic Scenarios)
# Voice options:
#   Male:   en-US-ChristopherNeural (deep), en-US-GuyNeural (casual)
#   Female: en-US-JennyNeural (warm), en-US-AriaNeural (clear)
DEFAULT_VOICE=en-US-ChristopherNeural

# --- Server ---
HOST=0.0.0.0
PORT=8000
STORAGE_DIR=./storage
FRONTEND_URL=http://localhost:3000
